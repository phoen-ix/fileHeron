# =============================================================================
# fileHeron .env.example
# Copy to .env, fill secrets. Required values use ${VAR:?...} in compose so the
# stack refuses to start if any are missing.
# =============================================================================

# --- Compose / ports ---------------------------------------------------------
COMPOSE_PROJECT_NAME=fileheron
# fileHeron's backend binds to 127.0.0.1:<APP_BACKEND_PORT>; add a Traefik route
# on the host pointing to that port. SPA on 127.0.0.1:<APP_FRONTEND_PORT>.
APP_BACKEND_PORT=8000
APP_FRONTEND_PORT=8080
# Dev-only: expose MariaDB on 127.0.0.1:<DB_EXTERNAL_PORT> for tools.
DB_EXTERNAL_PORT=3307
REDIS_EXTERNAL_PORT=6380

# --- Environment -------------------------------------------------------------
# development | production. In production COOKIE_SECURE is forced true and
# fail-fast checks abort startup on insecure defaults.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (MariaDB) ------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=fileheron
DB_USER=fileheron_app
DB_PASSWORD=change_me_in_production
DB_ROOT_PASSWORD=change_root_password

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth: JWT + cookies -----------------------------------------------------
# Min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_64_char_string_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true in production (HTTPS via Traefik). Forced true when ENVIRONMENT=production.
COOKIE_SECURE=false

# --- Argon2id parameters -----------------------------------------------------
# OWASP-recommended baseline. Adjust if VPS is constrained.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2

# --- Admin bootstrap ---------------------------------------------------------
# If set, the user with this email is auto-promoted to admin + email-verified
# on registration. If they're already registered, they get promoted on next
# backend startup. Leave empty to disable.
ADMIN_BOOTSTRAP_EMAIL=admin@fileheron.local
# If set AND no admin exists yet, an admin is created on startup with this
# email + this password. Leave empty to skip auto-creation.
ADMIN_BOOTSTRAP_PASSWORD=

# --- Dev/test account --------------------------------------------------------
# Auto-seeded on startup if all three are set. Idempotent. Refuses to run when
# ENVIRONMENT=production. If TEST_ACCOUNT_EMAIL == ADMIN_BOOTSTRAP_EMAIL, the
# seeded account is admin.
TEST_ACCOUNT_EMAIL=test@fileheron.local
TEST_ACCOUNT_PASSWORD=FileHeronDev2026!
TEST_ACCOUNT_DISPLAY_NAME=Test User

# --- SMTP --------------------------------------------------------------------
# Leave SMTP_HOST empty in dev → emails are logged to backend stdout instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fileheron.local
SMTP_FROM_NAME=fileHeron

# --- Application -------------------------------------------------------------
# Public-facing URL — used in email links (verify, reset, invite, share, etc.)
APP_URL=http://localhost:8080
# User-facing brand name (rendered in emails, subjects, UI page titles).
# Use the colon spelling here. Container/file/code identifiers stay "fileHeron".
APP_NAME=file:Heron

# --- Rate limits (per window) ------------------------------------------------
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=3

# --- Upload pipeline (Phase 3a) ----------------------------------------------
# Shared HMAC secret for tusd ↔ backend. Backend signs Upload-Metadata
# envelopes; tusd forwards them on each hook; backend verifies. Generate
# with: openssl rand -hex 32
TUS_HOOK_SECRET=change_this_to_a_random_64_char_hex_string_for_tus_hmac

# Direct-upload (multipart) endpoint size cap. Files larger than this must
# go through TUS (resumable). 100 MB.
MAX_DIRECT_UPLOAD_BYTES=104857600

# Where finalized files live inside the backend container. Must be on the
# same filesystem as TUS_UPLOAD_DIR so post-finish move is atomic.
STORAGE_ROOT=/data/files
TUS_UPLOAD_DIR=/data/uploads
QUARANTINE_DIR=/data/quarantine

# Public path the browser uses to reach tusd (proxied via the frontend nginx
# in prod / Vite in dev). Trailing slash matters for tusd's -base-path.
TUS_PUBLIC_BASE=/uploads/

# Phase 5 — antivirus scanning. clamd inside the docker network. Set
# AV_SKIP=true to bypass the scanner entirely (every upload auto-marked
# clean). Useful in tests / CI; never set in production.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
AV_SKIP=false

# 2FA enforcement env fallback. `none` = optional (default), `admins` =
# required for admins, `all` = required for every user. Used as the fallback
# when the admin-editable kv policy (`twofa.required_roles` /
# `twofa.required_group_ids` in app_settings) is unset. Once an admin saves
# the policy via /admin/settings/twofa, the kv values win and this env is
# ignored. Computed live per request — no users.requires_2fa_setup column
# anymore (dropped in migration 202605021000).
REQUIRE_2FA=none

# Phase 7 — HIBP k-anonymity password breach check. Set false in air-gapped
# deploys.
HIBP_ENABLED=true

# Phase 7 — OIDC SSO for company employees. Empty issuer disables SSO entirely;
# the Login page won't show the SSO button. Both client_id and client_secret are
# required for the flow.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Dot-walkable path to the groups list in the ID-token claims. Defaults to
# "groups"; Keycloak ships them under "realm_access.roles".
OIDC_GROUPS_CLAIM=groups
# Comma-separated group names. Admin > employee > client (first match wins).
OIDC_ADMIN_GROUPS=
OIDC_EMPLOYEE_GROUPS=

# Phase 7 — backup target. If set, scripts/backup.sh pushes the produced
# archive to this restic repo using BACKUP_RESTIC_PASSWORD. Examples:
#   s3:s3.amazonaws.com/my-bucket/repo
#   rest:https://restic.example.com/
#   /mnt/external-drive/restic-repo
BACKUP_RESTIC_REPO=
BACKUP_RESTIC_PASSWORD=
