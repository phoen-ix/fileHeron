# =============================================================================
# fileHeron .env.example
# Copy to .env, fill secrets. Required values use ${VAR:?...} in compose so the
# stack refuses to start if any are missing.
# =============================================================================

# --- Compose / ports ---------------------------------------------------------
COMPOSE_PROJECT_NAME=fileheron
# fileHeron's backend binds to 127.0.0.1:<APP_BACKEND_PORT>; add a Traefik route
# on the host pointing to that port. SPA on 127.0.0.1:<APP_FRONTEND_PORT>.
APP_BACKEND_PORT=8000
APP_FRONTEND_PORT=8080
# Dev-only: expose MariaDB on 127.0.0.1:<DB_EXTERNAL_PORT> for tools.
DB_EXTERNAL_PORT=3307
REDIS_EXTERNAL_PORT=6380

# --- Environment -------------------------------------------------------------
# development | production. In production COOKIE_SECURE is forced true and
# fail-fast checks abort startup on insecure defaults.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (MariaDB) ------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=fileheron
DB_USER=fileheron_app
DB_PASSWORD=change_me_in_production
DB_ROOT_PASSWORD=change_root_password

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth: JWT + cookies -----------------------------------------------------
# Min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_64_char_string_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true in production (HTTPS via Traefik). Forced true when ENVIRONMENT=production.
COOKIE_SECURE=false
# Per-user concurrent session cap. On login, if the user already has this many
# active refresh tokens, the oldest is auto-revoked (and the user notified).
MAX_ACTIVE_SESSIONS_PER_USER=10
# How long revoked refresh-token rows linger for forensics before the hourly
# cleanup hard-deletes them.
REFRESH_TOKEN_RETENTION_DAYS=30
# How long pending/expired invite tokens linger before the daily cleanup purges
# them (consumed invites are kept indefinitely as proof-of-onboarding).
INVITE_RETENTION_DAYS=14

# NOTE: most numeric knobs below (sessions, rate limits, retention, upload cap,
# HIBP, branding) are *boot defaults* - an admin can override them live, without
# a redeploy, at /admin/settings/advanced (they overlay these env values).

# --- Argon2id parameters -----------------------------------------------------
# OWASP-recommended baseline. Adjust if VPS is constrained.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2

# --- Admin bootstrap ---------------------------------------------------------
# If set, the user with this email is auto-promoted to admin + email-verified
# on registration. If they're already registered, they get promoted on next
# backend startup. Leave empty to disable.
ADMIN_BOOTSTRAP_EMAIL=
# If set AND no admin exists yet, an admin is created on startup with this
# email + this password. Leave empty to skip auto-creation.
ADMIN_BOOTSTRAP_PASSWORD=

# --- Dev/test account --------------------------------------------------------
# Auto-seeded on startup if all three are set. Idempotent. Refuses to run when
# ENVIRONMENT=production. If TEST_ACCOUNT_EMAIL == ADMIN_BOOTSTRAP_EMAIL, the
# seeded account is admin.
TEST_ACCOUNT_EMAIL=test@fileheron.local
TEST_ACCOUNT_PASSWORD=FileHeronDev2026!
TEST_ACCOUNT_DISPLAY_NAME=Test User

# --- SMTP --------------------------------------------------------------------
# Leave SMTP_HOST empty in dev → emails are logged to backend stdout instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fileheron.local
SMTP_FROM_NAME=fileHeron
# EHLO/HELO hostname announced to the SMTP server. Leave empty to use the
# container's auto-detected FQDN. Set to a real, resolvable hostname (often
# the from_email domain) when a strict MTA rejects with "Client host rejected".
SMTP_HELO_HOST=

# --- Application -------------------------------------------------------------
# Public-facing URL - used in email links (verify, reset, invite, share, etc.)
APP_URL=http://localhost:8080
# User-facing brand name (rendered in emails, subjects, UI page titles).
# Use the colon spelling here. Container/file/code identifiers stay "fileHeron".
APP_NAME=file:Heron

# --- Rate limits + account lockout -------------------------------------------
# RATE_LIMIT_LOGIN gates /login + /login/recovery; RATE_LIMIT_REGISTER gates
# /register-from-invite + /forgot-password + /verify-email (per IP per window).
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=3
# Per-IP login window (seconds). 900 = 15 min.
LOGIN_RATE_WINDOW_SEC=900
# Consecutive login failures that lock an account, and for how long (minutes).
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MIN=15

# --- Upload pipeline (Phase 3a) ----------------------------------------------
# Shared HMAC secret for tusd ↔ backend. Backend signs Upload-Metadata
# envelopes; tusd forwards them on each hook; backend verifies. Generate
# with: openssl rand -hex 32
TUS_HOOK_SECRET=change_this_to_a_random_64_char_hex_string_for_tus_hmac
# Optional CSV allowlist for the source IP of /api/internal/tus-hooks
# (defense-in-depth on top of the HMAC envelope). Empty = accept any source.
# In compose, set to the tusd container's network address.
TUS_HOOK_ALLOWED_IPS=

# --- Self-update + image tag (v1.0.0) ----------------------------------------
# FH_TAG controls which GHCR image tag the compose stack pulls. Set to a
# specific SemVer (e.g. v1.0.0) to pin, or leave as `latest`. The in-app
# self-update flow rewrites this when an admin clicks Update.
#
# The v1.0.0 architecture is filesystem-based (no HMAC) - the backend
# writes update requests to data/updater/current_job.json which the shim
# container polls and acts on. Trust is filesystem-membership.
FH_TAG=latest

# Optional: only override if your compose project doesn't live at the
# default `/opt/fileHeron`. Used by the updater-shim when it spawns the
# ephemeral executor container: the executor's bind mounts are resolved
# against the host filesystem, not the container's view, so the shim
# needs the host-side absolute path. Compose's default is ${PWD}.
# UPDATER_HOST_WORKSPACE=/opt/fileHeron
# UPDATER_HOST_STATE=/opt/fileHeron/data/updater

# Direct-upload (multipart) endpoint size cap. Files larger than this must
# go through TUS (resumable). 100 MB.
MAX_DIRECT_UPLOAD_BYTES=104857600

# Where finalized files live inside the backend container. Must be on the
# same filesystem as TUS_UPLOAD_DIR so post-finish move is atomic.
STORAGE_ROOT=/data/files
TUS_UPLOAD_DIR=/data/uploads
QUARANTINE_DIR=/data/quarantine

# Public path the browser uses to reach tusd (proxied via the frontend nginx
# in prod / Vite in dev). Trailing slash matters for tusd's -base-path.
TUS_PUBLIC_BASE=/uploads/

# Phase 5 - antivirus scanning. clamd inside the docker network. Set
# AV_SKIP=true to bypass the scanner entirely (every upload auto-marked
# clean). Useful in tests / CI; never set in production.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
AV_SKIP=false

# Public-link password brute-force protection. After RATE_LIMIT wrong tries
# within WINDOW_SEC, the link itself (all IPs) is locked for LOCKOUT_SEC.
PUBLIC_LINK_PASSWORD_RATE_LIMIT=10
PUBLIC_LINK_PASSWORD_WINDOW_SEC=900
PUBLIC_LINK_LOCKOUT_SEC=900

# 2FA enforcement env fallback. `none` = optional (default), `admins` =
# required for admins, `all` = required for every user. Used as the fallback
# when the admin-editable kv policy (`twofa.required_roles` /
# `twofa.required_group_ids` in app_settings) is unset. Once an admin saves
# the policy via /admin/settings/twofa, the kv values win and this env is
# ignored. Computed live per request - no users.requires_2fa_setup column
# anymore (dropped in migration 202605021000).
REQUIRE_2FA=none

# Phase 7 - HIBP k-anonymity password breach check. Set false in air-gapped
# deploys.
HIBP_ENABLED=true

# SSO (OIDC) is configured at runtime by an admin under /admin/settings/sso
# (multi-provider, stored in the DB) - there are no OIDC env vars.

# Backup target for the HOST-side scripts/backup.sh (sourced from .env by the
# script itself; the app never reads these). If set, the produced archive is
# pushed to this restic repo using BACKUP_RESTIC_PASSWORD. Examples:
#   s3:s3.amazonaws.com/my-bucket/repo
#   rest:https://restic.example.com/
#   /mnt/external-drive/restic-repo
BACKUP_RESTIC_REPO=
BACKUP_RESTIC_PASSWORD=

# --- Phase 8 - WebAuthn / passkeys -------------------------------------------
# RP-ID MUST match the public hostname (no scheme, no port). Platform
# authenticators (Touch ID, Windows Hello) bind credentials to this string
# forever - change it and every registered passkey is invalidated.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=fileHeron
# Comma-separated allowed origins for the WebAuthn flow. Empty falls back to APP_URL.
WEBAUTHN_ORIGINS=

# --- Operational retention (cron housekeeping) -------------------------------
# The prune_history cron deletes rows older than these windows. Set any to 0 to
# disable that table's pruning. (All also tunable live at /admin/settings/advanced.)
AUDIT_LOG_RETENTION_DAYS=365
DOWNLOAD_LOG_RETENTION_DAYS=90
LOGIN_ATTEMPT_RETENTION_DAYS=30
# Read in-app notifications hard-deleted by cleanup_read_notifications after this.
NOTIFICATION_READ_RETENTION_DAYS=3
# purge_old_quarantine unlinks infected bytes (keeps the row marker) after this.
QUARANTINE_PURGE_AFTER_DAYS=90
# reclaim_orphaned_files frees bytes+quota for files whose share was revoked/
# deleted longer than this ago (grace window). 0 disables auto-reclaim.
ORPHAN_RECLAIM_AFTER_DAYS=7
# cleanup_abandoned_uploads unlinks partial/stuck TUS uploads older than this.
TUS_UPLOAD_ABANDONED_AFTER_HOURS=24
# cleanup_stale_uploads reaps `files` rows stuck in `uploading` longer than this
# (abandoned uploads) and marks the otherwise-empty share `failed`.
UPLOAD_STALE_AFTER_HOURS=3
