{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Eine hochgeladene Datei wurde unter Quarantäne gestellt{% endblock %}
{% block content %}
  {{ ui.eyebrow("Antivirus-Hinweis", tone="danger") }}
  {{ ui.headline("Eine Datei wurde unter Quarantäne gestellt") }}
  {% call ui.specs() %}
    {{ ui.spec("datei", filename) }}
    {{ ui.spec("signatur", signature|default("unbekannt")) }}
  {% endcall %}
  {% call ui.para(gap=0) %}Die Freigabe wurde widerrufen; Empfänger können nicht mehr herunterladen. Falls es sich um einen Fehlalarm handelt, wende dich an einen Admin.{% endcall %}
{% endblock %}
