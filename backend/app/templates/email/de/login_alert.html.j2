{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Anmeldung von einem neuen Gerät{% endblock %}
{% block content %}
  {{ ui.eyebrow("Sicherheit") }}
  {{ ui.headline("Neue Anmeldung") }}
  {% call ui.para() %}Hallo {{ display_name|default("zusammen") }},{% endcall %}
  {% call ui.para() %}An deinem {{ app_name }}-Konto erfolgte gerade eine Anmeldung von einem unbekannten Gerät.{% endcall %}
  {% call ui.specs() %}
    {{ ui.spec("wann", at|dt_locale(locale)) }}
    {{ ui.spec("methode", via|default("passwort")) }}
    {{ ui.spec("browser", ua_summary|default("unbekannt")) }}
    {{ ui.spec("IP-Adresse", ip_address|default("unbekannt")) }}
    {% if user_agent %}{{ ui.spec("User-Agent", user_agent, wrap=true) }}{% endif %}
  {% endcall %}
  {% call ui.para() %}Falls du das warst, ist nichts zu tun. Andernfalls ändere dein Passwort und überprüfe aktive Sitzungen.{% endcall %}
  {{ ui.button(account_url, "Konto prüfen") }}
{% endblock %}
