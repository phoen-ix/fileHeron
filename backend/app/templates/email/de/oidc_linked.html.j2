{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Ein Anmelde-Anbieter wurde mit deinem Konto verknüpft{% endblock %}
{% block content %}
  {{ ui.eyebrow("Sicherheitshinweis") }}
  {{ ui.headline("Ein Anmelde-Anbieter wurde mit deinem Konto verknüpft") }}
  {% call ui.para() %}Der Single-Sign-On-Anbieter <strong>{{ provider_name }}</strong> wurde gerade mit deinem {{ app_name }}-Konto verknüpft.{% endcall %}
  {% call ui.note() %}Wenn du das warst, musst du nichts tun. Falls du dich <strong>nicht</strong> gerade mit diesem Anbieter angemeldet hast, wende dich umgehend an deine Administratorin oder deinen Administrator - dein Konto könnte kompromittiert sein.{% endcall %}
  {{ ui.button(account_url, "Konto überprüfen") }}
{% endblock %}
