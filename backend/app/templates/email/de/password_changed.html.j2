{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Dein Passwort wurde geändert{% endblock %}
{% block content %}
  {{ ui.eyebrow("Sicherheitshinweis") }}
  {{ ui.headline("Dein Passwort wurde geändert") }}
  {{ ui.para("Hallo " ~ display_name ~ ",") }}
  {{ ui.para("Das Passwort deines " ~ app_name ~ "-Kontos wurde gerade geändert.") }}
  {% call ui.specs() %}
    {{ ui.spec("Quelle", ip_hint|default("unbekannt")) }}
  {% endcall %}
  {{ ui.note("Falls du diese Änderung vorgenommen hast, kannst du diese E-Mail ignorieren.") }}
  {% call ui.para() %}Falls du dein Passwort <strong>nicht</strong> geändert hast, ist dein Konto möglicherweise kompromittiert. Setze es sofort zurück.{% endcall %}
  {{ ui.button(reset_url, "Passwort zurücksetzen", gap=24) }}
  {{ ui.note("Aus Sicherheitsgründen wurden beim Ändern des Passworts alle anderen angemeldeten Sitzungen beendet - wer dein Konto anderswo nutzte, wurde abgemeldet.", gap=0) }}
{% endblock %}
