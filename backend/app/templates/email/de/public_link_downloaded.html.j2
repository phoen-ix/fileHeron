{% extends "layout.html.j2" %}
{% block subject %}Ein öffentlicher Link zu deinen Dateien wurde geöffnet{% endblock %}
{% block content %}
  <p style="margin:0 0 12px 0;color:#6b7280;font-family:Georgia,serif;font-style:italic;">Öffentlicher Link</p>
  <h1 style="font-family:Georgia,'Times New Roman',serif;font-weight:normal;font-size:26px;line-height:1.2;margin:0 0 16px 0;color:#1a1d24;">
    Eine Datei aus deinem öffentlichen Link wurde heruntergeladen
  </h1>
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px 0;width:100%;font-family:'JetBrains Mono',Menlo,Consolas,monospace;font-size:13px;">
    <tr><td style="padding:4px 0;color:#6b7280;">datei</td><td style="padding:4px 0;color:#1a1d24;">{{ filename }}</td></tr>
    <tr><td style="padding:4px 0;color:#6b7280;">größe</td><td style="padding:4px 0;color:#1a1d24;">{{ size_bytes }} Bytes</td></tr>
    <tr><td style="padding:4px 0;color:#6b7280;">wann</td><td style="padding:4px 0;color:#1a1d24;">{{ at|dt_locale(locale) }}</td></tr>
    {% if downloads_remaining is not none %}
    <tr><td style="padding:4px 0;color:#6b7280;">verbleibend</td><td style="padding:4px 0;color:#1a1d24;">{{ downloads_remaining }}</td></tr>
    {% endif %}
  </table>
  <p style="margin:0;">
    <a href="{{ share_url }}" style="display:inline-block;background:#1a1d24;color:#faf8f3;text-decoration:none;padding:12px 24px;font-weight:500;">
      Link verwalten →
    </a>
  </p>
{% endblock %}
