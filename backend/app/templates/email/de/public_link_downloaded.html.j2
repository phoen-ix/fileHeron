{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Ein öffentlicher Link zu deinen Dateien wurde geöffnet{% endblock %}
{% block content %}
  {{ ui.eyebrow("Öffentlicher Link") }}
  {{ ui.headline("Eine Datei aus deinem öffentlichen Link wurde heruntergeladen") }}
  {% call ui.specs() %}
    {{ ui.spec("datei", filename) }}
    {{ ui.spec("größe", size_bytes ~ " Bytes") }}
    {{ ui.spec("wann", at|dt_locale(locale)) }}
    {% if downloads_remaining is not none %}{{ ui.spec("verbleibend", downloads_remaining) }}{% endif %}
  {% endcall %}
  {{ ui.button(share_url, "Link verwalten") }}
{% endblock %}
