{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{{ app_name }} {{ version }} ist verfügbar{% endblock %}
{% block content %}
  {{ ui.eyebrow("Aktualisierung") }}
  {{ ui.headline(app_name ~ " " ~ version ~ " ist verfügbar", size="lg") }}
  {% call ui.para() %}Hallo {{ recipient_name|default("zusammen") }},{% endcall %}
  {% call ui.specs() %}
    {{ ui.spec("neue Version", version) }}
    {{ ui.spec("aktuell installiert", running_version) }}
  {% endcall %}
  {% call ui.para() %}Du kannst das Update unter <strong>/admin/system</strong> auf deiner Instanz einspielen.{% endcall %}
  {% if release_url %}{{ ui.button(release_url, "Release Notes auf GitHub") }}{% endif %}
{% endblock %}
