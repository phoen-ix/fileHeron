{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Passwort zurücksetzen{% endblock %}
{% block content %}
  {{ ui.eyebrow("Passwort zurücksetzen") }}
  {{ ui.headline("Neues Passwort setzen") }}
  {{ ui.para("Hallo " ~ display_name ~ ",") }}
  {{ ui.para("für dein " ~ app_name ~ "-Konto wurde ein Passwort-Reset angefordert.", gap=24) }}
  {{ ui.button(reset_url, "Neues Passwort setzen", gap=24) }}
  {{ ui.note("Der Link ist 1 Stunde gültig und kann nur einmal verwendet werden. Wenn du das nicht warst, ignoriere die E-Mail - dein Passwort bleibt unverändert.", gap=0) }}
{% endblock %}
