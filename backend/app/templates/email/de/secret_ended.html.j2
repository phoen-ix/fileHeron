{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Dein Geheimnis ist beendet{% endblock %}
{% block content %}
  {{ ui.eyebrow("Geheimnis") }}
  {{ ui.headline(label if label else "Dein Geheimnis ist beendet") }}
  {% call ui.para() %}{% if reason == "burned" %}Es wurde so oft angesehen, wie du erlaubt hast ({{ views_used }}-mal), und ist jetzt vernichtet.{% elif reason == "expired_unread" %}Es ist abgelaufen, bevor es jemand angesehen hat, und ist jetzt vernichtet.{% elif reason == "revoked_by_admin" %}Ein Administrator hat es vernichtet. Es kann nicht mehr angesehen werden.{% else %}Es ist beendet und vernichtet.{% endif %}{% endcall %}
  {{ ui.button(secret_url, "Details ansehen") }}
{% endblock %}
