{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{{ sender_name }} hat dir ein Geheimnis gesendet{% endblock %}
{% block content %}
  {% set title = label if label else sender_name ~ " hat dir ein Geheimnis gesendet" %}
  {{ ui.eyebrow("Ein Geheimnis für dich") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para() %}<strong>{{ sender_name }}</strong> hat dir über {{ app_name }} ein Geheimnis gesendet. Melde dich an, um es zu öffnen.{% endcall %}
  {% if max_views %}{% call ui.note() %}{% if view_scope == "total" or shared_with_group %}Es kann insgesamt <strong>{{ max_views }}</strong>-mal geöffnet werden{% if shared_with_group %}, von deiner Gruppe gemeinsam{% endif %}.{% else %}Du kannst es <strong>{{ max_views }}</strong>-mal öffnen.{% endif %} Speichere es beim Öffnen an einem sicheren Ort.{% endcall %}{% endif %}
  {% if has_passphrase %}{% call ui.note() %}Zum Öffnen brauchst du eine Passphrase. <strong>{{ sender_name }}</strong> gibt sie dir separat.{% endcall %}{% endif %}
  {% if expires_at %}{% call ui.note(gap=24) %}Verfügbar bis <strong>{{ expires_at|dt_locale(locale) }}</strong>.{% endcall %}{% endif %}
  {{ ui.button(secret_url, "Geheimnis öffnen", gap=24) }}
  {{ ui.note("Das Geheimnis selbst wird nie per E-Mail versendet.", gap=0) }}
{% endblock %}
