{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{{ requester_name }} bittet dich um ein Geheimnis{% endblock %}
{% block content %}
  {{ ui.eyebrow("Bitte um ein Geheimnis") }}
  {{ ui.headline(label, size="lg") }}
  {% call ui.para() %}<strong>{{ requester_name }}</strong> bittet dich über {{ app_name }} um ein Geheimnis. Gib es auf der Seite hinter dem Button ein - nur {{ requester_name }} kann es öffnen.{% endcall %}
  {% if note %}{% call ui.note() %}{{ note }}{% endcall %}{% endif %}
  {% if expires_at %}{% call ui.note(gap=24) %}Offen bis <strong>{{ expires_at|dt_locale(locale) }}</strong>. Der Link funktioniert einmal.{% endcall %}{% endif %}
  {{ ui.button(link_url, "Anfrage beantworten", gap=24) }}
  {{ ui.note("Du brauchst kein Konto. Antworte nie per E-Mail mit dem Geheimnis und leite diese E-Mail bitte nicht weiter. Falls du sie nicht erwartet hast, kannst du sie ignorieren.", gap=0) }}
{% endblock %}
