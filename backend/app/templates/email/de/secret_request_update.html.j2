{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{% if outcome == "expired" %}Deine Anfrage wurde nicht beantwortet{% else %}Dein Geheimnis ist angekommen{% endif %}{% endblock %}
{% block content %}
  {{ ui.eyebrow("Deine Anfrage") }}
  {{ ui.headline(label) }}
  {% if outcome == "expired" %}
  {% call ui.para() %}Niemand hat geantwortet, bevor die Anfrage geschlossen wurde. Du kannst erneut fragen.{% endcall %}
  {{ ui.button(secret_url, "Anfrage ansehen") }}
  {% else %}
  {% call ui.para() %}{% if answered_by %}<strong>{{ answered_by }}</strong> hat geantwortet{% else %}Jemand mit dem Link der Anfrage hat geantwortet{% endif %}. Melde dich an, um es zu öffnen - nur du kannst das.{% endcall %}
  {{ ui.button(secret_url, "Geheimnis öffnen", gap=24) }}
  {{ ui.note("Das Geheimnis selbst wird nie per E-Mail versendet.", gap=0) }}
  {% endif %}
{% endblock %}
