{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{{ requester_name }} bittet dich um ein Geheimnis{% endblock %}
{% block content %}
  {{ ui.eyebrow("Bitte um ein Geheimnis") }}
  {{ ui.headline(label, size="lg") }}
  {% call ui.para() %}<strong>{{ requester_name }}</strong> bittet dich über {{ app_name }} um ein Geheimnis. Melde dich an, um es zu senden - nur {{ requester_name }} kann es öffnen.{% endcall %}
  {% if note %}{% call ui.note() %}{{ note }}{% endcall %}{% endif %}
  {% if expires_at %}{% call ui.note(gap=24) %}Offen bis <strong>{{ expires_at|dt_locale(locale) }}</strong>. Die erste Antwort schließt die Anfrage.{% endcall %}{% endif %}
  {{ ui.button(request_url, "Anfrage beantworten", gap=24) }}
  {{ ui.note("Antworte nie per E-Mail mit dem Geheimnis - sende es auf der Seite der Anfrage.", gap=0) }}
{% endblock %}
