{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Dein Geheimnis wurde angesehen{% endblock %}
{% block content %}
  {{ ui.eyebrow("Geheimnis") }}
  {{ ui.headline(label if label else "Dein Geheimnis wurde angesehen") }}
  {% call ui.para() %}Dein Geheimnis wurde gerade angesehen{% if via == "user" and viewer %} - von <strong>{{ viewer }}</strong>{% elif via == "email" and viewer %} - über den Link an <strong>{{ viewer }}</strong>{% elif via == "link" %} - über seinen Link{% endif %}.{% endcall %}
  {% call ui.specs() %}
    {{ ui.spec("am", at|dt_locale(locale)) }}
    {% if ip %}{{ ui.spec("von", ip) }}{% endif %}
    {% if views_left is not none %}{{ ui.spec("übrig", views_left) }}{% endif %}
  {% endcall %}
  {{ ui.button(secret_url, "Ansehen, wer es geöffnet hat") }}
{% endblock %}
