{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Eine Sitzung wurde abgemeldet{% endblock %}
{% block content %}
  {{ ui.eyebrow("Sicherheit") }}
  {{ ui.headline("Eine Sitzung wurde abgemeldet") }}
  {% call ui.para() %}Hallo {{ display_name|default("zusammen") }},{% endcall %}
  {% call ui.para() %}{% if count and count > 1 %}{{ count }} ältere Sitzungen wurden{% else %}Eine ältere Sitzung wurde{% endif %} von deinem {{ app_name }}-Konto abgemeldet, weil du dein Limit von {{ cap }} Sitzungen erreicht hast.{% endcall %}
  {% call ui.para() %}Das ist normal, wenn du auf mehr als {{ cap }} Geräten angemeldet bleibst - die am längsten inaktive Sitzung wird abgemeldet, um Platz zu schaffen. Falls du das nicht warst, ändere dein Passwort und überprüfe deine aktiven Sitzungen.{% endcall %}
  {{ ui.button(app_url ~ "/account", "Konto überprüfen") }}
{% endblock %}
