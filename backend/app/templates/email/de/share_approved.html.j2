{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Deine Freigabe wurde genehmigt{% endblock %}
{% block content %}
  {% set title = subject if subject else "Deine Freigabe ist aktiv" %}
  {{ ui.eyebrow("Genehmigt") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para(gap=24) %}Deine Freigabe wurde genehmigt und steht den Empfängern nun zur Verfügung.{% endcall %}
  {{ ui.button(share_url, "Freigabe öffnen") }}
{% endblock %}
