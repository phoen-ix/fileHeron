{% extends "layout.html.j2" %}
{% block subject %}{{ sender_name }} hat dir Dateien gesendet{% endblock %}
{% block content %}
  <p style="margin:0 0 12px 0;color:#6b7280;font-family:Georgia,serif;font-style:italic;">Neue Freigabe</p>
  <h1 style="font-family:Georgia,'Times New Roman',serif;font-weight:normal;font-size:28px;line-height:1.15;letter-spacing:-0.01em;margin:0 0 16px 0;color:#1a1d24;">
    {% if subject %}{{ subject }}{% else %}{{ sender_name }} hat dir Dateien gesendet{% endif %}
  </h1>
  <p style="margin:0 0 16px 0;">
    <strong>{{ sender_name }}</strong> hat {{ file_count }} Datei{% if file_count != 1 %}en{% endif %} mit dir geteilt.
  </p>
  {% if message %}
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-left:2px solid #e5e1d8;background:#faf8f3;margin:0 0 16px 0;width:100%;">
      <tr><td style="padding:12px 16px;color:#1a1d24;white-space:pre-wrap;">{{ message }}</td></tr>
    </table>
  {% endif %}
  {% if expires_at %}
    <p style="margin:0 0 24px 0;color:#6b7280;font-size:14px;">
      Verfügbar bis <strong>{{ expires_at|dt_locale(locale) }}</strong>.
    </p>
  {% endif %}
  <p style="margin:0;">
    <a href="{{ share_url }}" style="display:inline-block;background:#1a1d24;color:#faf8f3;text-decoration:none;padding:12px 24px;font-weight:500;">
      Freigabe öffnen →
    </a>
  </p>
{% endblock %}
