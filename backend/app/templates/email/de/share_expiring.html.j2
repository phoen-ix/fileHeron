{% extends "layout.html.j2" %}
{% block subject %}Deine Freigabe läuft in 24 Stunden ab{% endblock %}
{% block content %}
  <p style="margin:0 0 12px 0;color:#6b7280;font-family:Georgia,serif;font-style:italic;">Erinnerung</p>
  <h1 style="font-family:Georgia,'Times New Roman',serif;font-weight:normal;font-size:26px;line-height:1.2;margin:0 0 16px 0;color:#1a1d24;">
    Deine Freigabe läuft in 24 Stunden ab
  </h1>
  <p style="margin:0 0 16px 0;">
    Die Freigabe <strong>{{ subject|default("(kein Betreff)") }}</strong> läuft am
    <strong>{{ expires_at|dt_locale(locale) }}</strong> ab.
  </p>
  <p style="margin:0 0 24px 0;color:#6b7280;font-size:14px;">
    Danach werden die Dateien aus {{ app_name }} gelöscht.
  </p>
  <p style="margin:0;">
    <a href="{{ share_url }}" style="display:inline-block;background:#1a1d24;color:#faf8f3;text-decoration:none;padding:12px 24px;font-weight:500;">
      Freigabe öffnen →
    </a>
  </p>
{% endblock %}
