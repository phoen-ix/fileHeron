{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Deine Freigabe läuft in 24 Stunden ab{% endblock %}
{% block content %}
  {{ ui.eyebrow("Erinnerung") }}
  {{ ui.headline("Deine Freigabe läuft in 24 Stunden ab") }}
  {% call ui.para() %}Die Freigabe <strong>{{ subject|default("(kein Betreff)") }}</strong> läuft am <strong>{{ expires_at|dt_locale(locale) }}</strong> ab.{% endcall %}
  {% call ui.note(gap=24) %}Danach werden die Dateien aus {{ app_name }} gelöscht.{% endcall %}
  {{ ui.button(share_url, "Freigabe öffnen") }}
{% endblock %}
