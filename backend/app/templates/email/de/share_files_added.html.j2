{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{{ sender_name }} hat Dateien zu einer Freigabe hinzugefügt{% endblock %}
{% block content %}
  {% set title = subject if subject else sender_name ~ " hat Dateien hinzugefügt" %}
  {{ ui.eyebrow("Neue Dateien hinzugefügt") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para(gap=24) %}<strong>{{ sender_name }}</strong> hat {{ added_count }} neue Datei{% if added_count != 1 %}en{% endif %} zu einer Freigabe mit dir hinzugefügt.{% endcall %}
  {{ ui.button(share_url, "Freigabe öffnen") }}
{% endblock %}
