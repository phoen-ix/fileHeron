{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Eine Freigabe benötigt deine Genehmigung{% endblock %}
{% block content %}
  {% set title = subject if subject else sender_name ~ " hat eine Freigabe erstellt" %}
  {{ ui.eyebrow("Wartet auf Genehmigung") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para(gap=24) %}<strong>{{ sender_name }}</strong> hat eine Freigabe erstellt, die deine Genehmigung benötigt, bevor die Empfänger darauf zugreifen können.{% endcall %}
  {{ ui.button(share_url, "Prüfen & entscheiden") }}
{% endblock %}
