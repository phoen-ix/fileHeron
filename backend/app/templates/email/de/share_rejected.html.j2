{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Deine Freigabe wurde nicht genehmigt{% endblock %}
{% block content %}
  {% set title = subject if subject else "Deine Freigabe wurde nicht genehmigt" %}
  {{ ui.eyebrow("Nicht genehmigt") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para() %}Deine Freigabe wurde geprüft und nicht genehmigt.{% endcall %}
  {% if reason %}{% call ui.quote() %}<strong>Grund:</strong> {{ reason }}{% endcall %}{% endif %}
  {% call ui.note(gap=24) %}Die Dateien bleiben erhalten - du kannst sie überarbeiten und erneut einreichen.{% endcall %}
  {{ ui.button(share_url, "Freigabe öffnen") }}
{% endblock %}
