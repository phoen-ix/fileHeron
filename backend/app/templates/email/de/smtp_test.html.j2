{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}SMTP-Test von {{ app_name }}{% endblock %}
{% block content %}
  {{ ui.eyebrow("Verbindungstest") }}
  {{ ui.headline("SMTP-Konfiguration funktioniert", size="lg") }}
  {% call ui.para() %}Wenn du das liest, funktionieren die aktuell unter {{ ui.mono("/admin/settings/email") }} gespeicherten SMTP-Werte für den ausgehenden E-Mail-Versand.{% endcall %}
  {% call ui.specs() %}
    {{ ui.spec("gesendet am", now|dt_locale(locale)) }}
  {% endcall %}
  {% call ui.note(gap=0) %}Diese Nachricht kannst du ignorieren - sie ist ein reiner Verbindungstest.{% endcall %}
{% endblock %}
