{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Your {{ app_name }} email address is being changed{% endblock %}
{% block content %}
  {{ ui.eyebrow("Security notice", tone="danger") }}
  {% if applied %}
    {{ ui.headline("Your email address was changed") }}
    {{ ui.para("Hi " ~ display_name ~ ",") }}
    {% call ui.para() %}The email address on your {{ app_name }} account was {% if by_admin %}changed by an administrator{% else %}changed{% endif %} to:{% endcall %}
    {% call ui.specs() %}
      {{ ui.spec("new address", new_email) }}
    {% endcall %}
    {{ ui.para("Your account signs in with that address as of now, and every signed-in session was ended. No confirmation from the new address was required.") }}
    {{ ui.note("This message is a security record sent to your previous address.") }}
    {% call ui.para() %}If you did <strong>not</strong> authorize this change, contact your administrator immediately and reset your password.{% endcall %}
    {{ ui.button(reset_url, "Reset my password") }}
  {% else %}
    {{ ui.headline("Your email address is being changed") }}
    {{ ui.para("Hi " ~ display_name ~ ",") }}
    {% call ui.para() %}A request to change the email address on your {{ app_name }} account was just made{% if by_admin %} by an administrator{% endif %}.{% endcall %}
    {% call ui.specs() %}
      {{ ui.spec("requested address", new_email) }}
    {% endcall %}
    {% call ui.para() %}Your current address still works and the change will <strong>not</strong> take effect unless it is confirmed from the new address.{% endcall %}
    {% if cancel_url %}{{ ui.button(cancel_url, "Cancel this change") }}{% endif %}
  {% endif %}
{% endblock %}
