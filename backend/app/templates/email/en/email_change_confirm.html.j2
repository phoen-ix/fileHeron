{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Confirm your new {{ app_name }} email address{% endblock %}
{% block content %}
  {{ ui.eyebrow("Email change") }}
  {{ ui.headline("Confirm your new email address") }}
  {{ ui.para("Hi " ~ display_name ~ ",") }}
  {% call ui.para() %}{% if by_admin %}An administrator requested a change of the email address on your {{ app_name }} account to this address.{% else %}You asked to change the email address on your {{ app_name }} account to this address.{% endif %}{% endcall %}
  {% call ui.specs() %}
    {{ ui.spec("new address", new_email) }}
  {% endcall %}
  {{ ui.button(confirm_url, "Confirm this address", gap=24) }}
  {{ ui.note("This link expires in 24 hours and can only be used once. Your current email keeps working until you confirm - nothing changes unless this link is clicked.", gap=0) }}
{% endblock %}
