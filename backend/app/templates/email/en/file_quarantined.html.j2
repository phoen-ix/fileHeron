{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}A file you uploaded was quarantined{% endblock %}
{% block content %}
  {{ ui.eyebrow("Antivirus alert", tone="danger") }}
  {{ ui.headline("A file was quarantined") }}
  {% call ui.specs() %}
    {{ ui.spec("file", filename) }}
    {{ ui.spec("signature", signature|default("unknown")) }}
  {% endcall %}
  {% call ui.para(gap=0) %}The share has been revoked; recipients can no longer download it. If you believe this is a false positive, contact an admin.{% endcall %}
{% endblock %}
