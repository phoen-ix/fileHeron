{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Sign-in from a new device{% endblock %}
{% block content %}
  {{ ui.eyebrow("Security") }}
  {{ ui.headline("A new sign-in") }}
  {% call ui.para() %}Hi {{ display_name|default("there") }},{% endcall %}
  {% call ui.para() %}Someone just signed in to your {{ app_name }} account from a device we hadn't seen before.{% endcall %}
  {% call ui.specs() %}
    {{ ui.spec("when", at|dt_locale(locale)) }}
    {{ ui.spec("method", via|default("password")) }}
    {{ ui.spec("browser", ua_summary|default("unknown")) }}
    {{ ui.spec("IP address", ip_address|default("unknown")) }}
    {% if user_agent %}{{ ui.spec("user agent", user_agent, wrap=true) }}{% endif %}
  {% endcall %}
  {% call ui.para() %}If this was you, no action is needed. If not, change your password and review active sessions.{% endcall %}
  {{ ui.button(account_url, "Review my account") }}
{% endblock %}
