{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}A sign-in provider was linked to your account{% endblock %}
{% block content %}
  {{ ui.eyebrow("Security notice") }}
  {{ ui.headline("A sign-in provider was linked to your account") }}
  {% call ui.para() %}The single sign-on provider <strong>{{ provider_name }}</strong> was just linked to your {{ app_name }} account.{% endcall %}
  {% call ui.note() %}If this was you, no action is needed. If you did <strong>not</strong> just sign in with this provider, contact your administrator immediately - your account may be compromised.{% endcall %}
  {{ ui.button(account_url, "Review your account") }}
{% endblock %}
