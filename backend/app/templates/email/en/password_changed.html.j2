{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Your password was changed{% endblock %}
{% block content %}
  {{ ui.eyebrow("Security notice") }}
  {{ ui.headline("Your password was changed") }}
  {{ ui.para("Hi " ~ display_name ~ ",") }}
  {{ ui.para("The password for your " ~ app_name ~ " account was just changed.") }}
  {% call ui.specs() %}
    {{ ui.spec("sign-in source", ip_hint|default("unknown")) }}
  {% endcall %}
  {{ ui.note("If you made this change, you can safely ignore this email.") }}
  {% call ui.para() %}If you did <strong>not</strong> change your password, your account may be compromised. Reset it immediately.{% endcall %}
  {{ ui.button(reset_url, "Reset my password", gap=24) }}
  {{ ui.note("All other signed-in sessions were ended when the password changed, so anyone using your account elsewhere has been signed out.", gap=0) }}
{% endblock %}
