{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Reset your password{% endblock %}
{% block content %}
  {{ ui.eyebrow("Password reset") }}
  {{ ui.headline("Set a new password") }}
  {{ ui.para("Hi " ~ display_name ~ ",") }}
  {{ ui.para("A password reset was requested for your " ~ app_name ~ " account.", gap=24) }}
  {{ ui.button(reset_url, "Set a new password", gap=24) }}
  {{ ui.note("This link expires in 1 hour and can only be used once. If you didn't request this, ignore this email - your password stays unchanged.", gap=0) }}
{% endblock %}
