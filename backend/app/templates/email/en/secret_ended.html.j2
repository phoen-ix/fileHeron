{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Your secret has ended{% endblock %}
{% block content %}
  {{ ui.eyebrow("Secret") }}
  {{ ui.headline(label if label else "Your secret has ended") }}
  {% call ui.para() %}{% if reason == "burned" %}It was viewed as often as you allowed ({{ views_used }} time{% if views_used != 1 %}s{% endif %}) and has been destroyed.{% elif reason == "expired_unread" %}It expired before anyone viewed it and has been destroyed.{% elif reason == "revoked_by_admin" %}An administrator burned it. It has been destroyed and can no longer be viewed.{% else %}It has ended and has been destroyed.{% endif %}{% endcall %}
  {{ ui.button(secret_url, "See the details") }}
{% endblock %}
