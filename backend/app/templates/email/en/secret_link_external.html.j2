{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{{ sender_name }} sent you a secret{% endblock %}
{% block content %}
  {% set title = label if label else sender_name ~ " sent you a secret" %}
  {{ ui.eyebrow("A secret for you") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para() %}<strong>{{ sender_name }}</strong> sent you a secret via {{ app_name }}.{% endcall %}
  {% if max_views %}{% call ui.note() %}{% if view_scope == "total" %}It can be opened <strong>{{ max_views }}</strong> time{% if max_views != 1 %}s{% endif %} in total, by everyone it was sent to.{% else %}You can open it <strong>{{ max_views }}</strong> time{% if max_views != 1 %}s{% endif %}.{% endif %} Copy it somewhere safe when you do.{% endcall %}{% endif %}
  {% if has_passphrase %}{% call ui.note() %}You need a passphrase to open it. <strong>{{ sender_name }}</strong> will give it to you separately.{% endcall %}{% endif %}
  {% if expires_at %}{% call ui.note(gap=24) %}Available until <strong>{{ expires_at|dt_locale(locale) }}</strong>.{% endcall %}{% endif %}
  {{ ui.button(link_url, "Open the secret", gap=24) }}
  {{ ui.note("You don't need an account. Anyone with this link can open the secret, so please don't forward this email. If you weren't expecting it, you can ignore it.", gap=0) }}
{% endblock %}
