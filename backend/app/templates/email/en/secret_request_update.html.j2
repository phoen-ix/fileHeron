{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{% if outcome == "expired" %}Your request was not answered{% else %}Your secret has arrived{% endif %}{% endblock %}
{% block content %}
  {{ ui.eyebrow("Your request") }}
  {{ ui.headline(label) }}
  {% if outcome == "expired" %}
  {% call ui.para() %}Nobody answered before the request closed. You can ask again.{% endcall %}
  {{ ui.button(secret_url, "See the request") }}
  {% else %}
  {% call ui.para() %}{% if answered_by %}<strong>{{ answered_by }}</strong> answered{% else %}Someone with the request link answered{% endif %}. Sign in to open it - you are the only one who can.{% endcall %}
  {{ ui.button(secret_url, "Open the secret", gap=24) }}
  {{ ui.note("The secret itself is never sent by email.", gap=0) }}
  {% endif %}
{% endblock %}
