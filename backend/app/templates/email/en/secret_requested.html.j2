{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{{ requester_name }} asks you for a secret{% endblock %}
{% block content %}
  {{ ui.eyebrow("A request for a secret") }}
  {{ ui.headline(label, size="lg") }}
  {% call ui.para() %}<strong>{{ requester_name }}</strong> asks you for a secret via {{ app_name }}. Sign in to send it - only they will be able to open it.{% endcall %}
  {% if note %}{% call ui.note() %}{{ note }}{% endcall %}{% endif %}
  {% if expires_at %}{% call ui.note(gap=24) %}Open until <strong>{{ expires_at|dt_locale(locale) }}</strong>. The first answer closes it.{% endcall %}{% endif %}
  {{ ui.button(request_url, "Answer the request", gap=24) }}
  {{ ui.note("Never reply to this email with the secret - send it on the request page.", gap=0) }}
{% endblock %}
