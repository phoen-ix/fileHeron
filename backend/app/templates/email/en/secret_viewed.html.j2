{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Your secret was viewed{% endblock %}
{% block content %}
  {{ ui.eyebrow("Secret") }}
  {{ ui.headline(label if label else "Your secret was viewed") }}
  {% call ui.para() %}Your secret was just viewed{% if via == "user" and viewer %} by <strong>{{ viewer }}</strong>{% elif via == "email" and viewer %} through the link sent to <strong>{{ viewer }}</strong>{% elif via == "link" %} through its link{% endif %}.{% endcall %}
  {% call ui.specs() %}
    {{ ui.spec("at", at|dt_locale(locale)) }}
    {% if ip %}{{ ui.spec("from", ip) }}{% endif %}
    {% if views_left is not none %}{{ ui.spec("left", views_left) }}{% endif %}
  {% endcall %}
  {{ ui.button(secret_url, "See who viewed it") }}
{% endblock %}
