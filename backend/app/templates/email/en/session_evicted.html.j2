{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}A session was signed out{% endblock %}
{% block content %}
  {{ ui.eyebrow("Security") }}
  {{ ui.headline("A session was signed out") }}
  {% call ui.para() %}Hi {{ display_name|default("there") }},{% endcall %}
  {% call ui.para() %}{% if count and count > 1 %}{{ count }} older sessions were{% else %}An older session was{% endif %} signed out of your {{ app_name }} account because you reached your {{ cap }}-session limit.{% endcall %}
  {% call ui.para() %}This is routine when you're signed in on more than {{ cap }} devices - the least-recently-active session is signed out to make room. If this wasn't you, change your password and review your active sessions.{% endcall %}
  {{ ui.button(app_url ~ "/account", "Review my account") }}
{% endblock %}
