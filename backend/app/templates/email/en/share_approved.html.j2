{% extends "layout.html.j2" %}
{% block subject %}Your share was approved{% endblock %}
{% block content %}
  <p style="margin:0 0 12px 0;color:#6b7280;font-family:Georgia,serif;font-style:italic;">Approved</p>
  <h1 style="font-family:Georgia,'Times New Roman',serif;font-weight:normal;font-size:28px;line-height:1.15;letter-spacing:-0.01em;margin:0 0 16px 0;color:#1a1d24;">
    {% if subject %}{{ subject }}{% else %}Your share is live{% endif %}
  </h1>
  <p style="margin:0 0 24px 0;">
    Your share was approved and is now available to its recipients.
  </p>
  <p style="margin:0;">
    <a href="{{ share_url }}" style="display:inline-block;background:#1a1d24;color:#faf8f3;text-decoration:none;padding:12px 24px;font-weight:500;">
      Open the share →
    </a>
  </p>
{% endblock %}
