{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Your share was approved{% endblock %}
{% block content %}
  {% set title = subject if subject else "Your share is live" %}
  {{ ui.eyebrow("Approved") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para(gap=24) %}Your share was approved and is now available to its recipients.{% endcall %}
  {{ ui.button(share_url, "Open the share") }}
{% endblock %}
