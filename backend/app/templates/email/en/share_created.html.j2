{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{{ sender_name }} sent you files{% endblock %}
{% block content %}
  {% set title = subject if subject else sender_name ~ " sent you files" %}
  {{ ui.eyebrow("A new share") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para() %}<strong>{{ sender_name }}</strong> shared {{ file_count }} file{% if file_count != 1 %}s{% endif %} with you.{% endcall %}
  {% if message %}{% call ui.quote() %}{{ message }}{% endcall %}{% endif %}
  {% if expires_at %}{% call ui.note(gap=24) %}Available until <strong>{{ expires_at|dt_locale(locale) }}</strong>.{% endcall %}{% endif %}
  {{ ui.button(share_url, "Open the share") }}
{% endblock %}
