{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Your share expires in 24 hours{% endblock %}
{% block content %}
  {{ ui.eyebrow("Reminder") }}
  {{ ui.headline("Your share expires in 24 hours") }}
  {% call ui.para() %}The share <strong>{{ subject|default("(no subject)") }}</strong> expires <strong>{{ expires_at|dt_locale(locale) }}</strong>.{% endcall %}
  {% call ui.note(gap=24) %}After that, the files are hard-deleted from {{ app_name }}.{% endcall %}
  {{ ui.button(share_url, "Open the share") }}
{% endblock %}
