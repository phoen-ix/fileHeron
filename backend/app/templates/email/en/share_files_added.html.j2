{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}{{ sender_name }} added files to a share{% endblock %}
{% block content %}
  {% set title = subject if subject else sender_name ~ " added files" %}
  {{ ui.eyebrow("New files added") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para(gap=24) %}<strong>{{ sender_name }}</strong> added {{ added_count }} new file{% if added_count != 1 %}s{% endif %} to a share with you.{% endcall %}
  {{ ui.button(share_url, "Open the share") }}
{% endblock %}
