{% extends "layout.html.j2" %}
{% block subject %}A share needs your approval{% endblock %}
{% block content %}
  <p style="margin:0 0 12px 0;color:#6b7280;font-family:Georgia,serif;font-style:italic;">Awaiting approval</p>
  <h1 style="font-family:Georgia,'Times New Roman',serif;font-weight:normal;font-size:28px;line-height:1.15;letter-spacing:-0.01em;margin:0 0 16px 0;color:#1a1d24;">
    {% if subject %}{{ subject }}{% else %}{{ sender_name }} created a share{% endif %}
  </h1>
  <p style="margin:0 0 24px 0;">
    <strong>{{ sender_name }}</strong> created a share that needs your approval before its recipients can access it.
  </p>
  <p style="margin:0;">
    <a href="{{ share_url }}" style="display:inline-block;background:#1a1d24;color:#faf8f3;text-decoration:none;padding:12px 24px;font-weight:500;">
      Review &amp; decide →
    </a>
  </p>
{% endblock %}
