{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}A share needs your approval{% endblock %}
{% block content %}
  {% set title = subject if subject else sender_name ~ " created a share" %}
  {{ ui.eyebrow("Awaiting approval") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para(gap=24) %}<strong>{{ sender_name }}</strong> created a share that needs your approval before its recipients can access it.{% endcall %}
  {{ ui.button(share_url, "Review & decide") }}
{% endblock %}
