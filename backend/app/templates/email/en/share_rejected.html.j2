{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}Your share was not approved{% endblock %}
{% block content %}
  {% set title = subject if subject else "Your share was not approved" %}
  {{ ui.eyebrow("Not approved") }}
  {{ ui.headline(title, size="lg") }}
  {% call ui.para() %}Your share was reviewed and not approved.{% endcall %}
  {% if reason %}{% call ui.quote() %}<strong>Reason:</strong> {{ reason }}{% endcall %}{% endif %}
  {% call ui.note(gap=24) %}The files are kept - you can revise and resubmit it.{% endcall %}
  {{ ui.button(share_url, "Open the share") }}
{% endblock %}
