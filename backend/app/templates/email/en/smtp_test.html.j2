{% extends "layout.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block subject %}SMTP test from {{ app_name }}{% endblock %}
{% block content %}
  {{ ui.eyebrow("Connectivity check") }}
  {{ ui.headline("SMTP configuration works", size="lg") }}
  {% call ui.para() %}If you're reading this, the SMTP values currently saved in {{ ui.mono("/admin/settings/email") }} work for outbound mail.{% endcall %}
  {% call ui.specs() %}
    {{ ui.spec("sent at", now|dt_locale(locale)) }}
  {% endcall %}
  {% call ui.note(gap=0) %}You can ignore this message. It's a routine connectivity check.{% endcall %}
{% endblock %}
