# Dev image - the production dependency closure plus the dev tools, with the
# source mounted by docker-compose.dev.yml for --reload.
FROM python:3.16.0a1-trixie

WORKDIR /app

# The full Debian image, not slim: on Python 3.15, hiredis and PyYAML ship no
# wheel and build from source, which needs its compiler. The prod image builds
# them in a separate stage and stays compiler-free; this image is never shipped.
# No apt installs, and the backend healthcheck runs Python, not curl.
#
# The runtime packages come hash-checked from requirements.lock, so the dev
# stack runs what production runs instead of whatever PyPI resolves today. The
# dev extras (pytest, ruff, mypy, ...) go on top, constrained by the same lock
# so they cannot move a runtime package. The constraints are a hash-stripped
# copy: pip refuses hashed constraints next to a local project ("Can't verify
# hashes ... because they point to directories").
COPY backend/pyproject.toml backend/requirements.lock ./
RUN --mount=type=cache,target=/root/.cache/pip pip install --require-hashes -r requirements.lock \
    && sed -e '/--hash=/d' -e 's/ \\$//' requirements.lock > /tmp/constraints.txt \
    && pip install -c /tmp/constraints.txt '.[dev]' \
    && rm /tmp/constraints.txt

COPY backend/alembic.ini ./alembic.ini
# app/, alembic/, scripts/, tests/ are mounted via docker-compose.dev.yml

COPY docker/backend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# appuser by number, as in the prod image.
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app /entrypoint.sh
USER 1000:1000

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
