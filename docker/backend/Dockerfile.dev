# Dev image - same as prod but with watchdog and source-mountable layout.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libmariadb-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml ./pyproject.toml
RUN --mount=type=cache,target=/root/.cache/pip pip install '.[dev]'

COPY backend/alembic.ini ./alembic.ini
# app/, alembic/, scripts/, tests/ are mounted via docker-compose.dev.yml

COPY docker/backend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app /entrypoint.sh
USER appuser

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
