# vue-router 5 declares an OPTIONAL peer on pinia@^3 via its @pinia/colada
# data-loader integration, which this app does not use. Without this flag npm
# aborts the install because we deliberately stay on pinia 2. legacy-peer-deps
# restores npm-6 peer behaviour: peers are not auto-installed and an unmet
# OPTIONAL peer does not fail the install. The committed package-lock.json is
# the source of truth; CI and the image build run `npm ci` against it.
legacy-peer-deps=true
