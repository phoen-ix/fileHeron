    "@vueuse/core": "^12.0.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "element-plus": "^2.9.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
