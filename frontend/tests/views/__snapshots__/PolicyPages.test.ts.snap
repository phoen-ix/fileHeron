// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`API tokens policy page > renders the same form markup 1`] = `"<form class="policy-form"><fieldset class="mode-fieldset"><legend class="fh-field-label">Base policy</legend><label class="mode-option"><input type="radio" value="everyone"><span><span class="mode-name">Everyone</span><span class="mode-help">Any signed-in user can create tokens.</span></span></label><label class="mode-option"><input type="radio" value="employees_admins"><span><span class="mode-name">Employees + admins</span><span class="mode-help">Clients cannot create tokens.</span></span></label><label class="mode-option"><input type="radio" value="admins_only"><span><span class="mode-name">Admins only</span><span class="mode-help">Only admins can create tokens.</span></span></label></fieldset><section class="allowlist"><h2 class="form-h2">Allowlist</h2><p class="fh-field-help">Users and groups added here can always mint tokens, regardless of the base policy.</p><div class="fh-field"><span class="fh-field-label">Specific users</span><ul class="picked-list"><li class="picked-row"><span class="row-name">Ada</span><span class="fh-mono row-hint">ada@test.local · employee</span><button type="button" class="fh-btn-text danger">Remove</button></li></ul><input aria-label="Search by name or email…" type="search" class="fh-field-input" autocomplete="off" placeholder="Search by name or email…"></div><div class="fh-field"><span class="fh-field-label">Group memberships</span><ul class="group-checks"><li><label class="group-check"><input type="checkbox" checked=""><span class="group-name">design</span></label></li><li><label class="group-check"><input type="checkbox"><span class="group-name">inbox</span><span class="fh-pill">company inbox</span></label></li></ul></div></section><div class="actions"><button type="submit" class="fh-btn">Save</button></div></form>"`;

exports[`public links policy page > renders the same form markup 1`] = `"<form class="policy-form"><fieldset class="mode-fieldset"><legend class="fh-field-label">Base policy</legend><label class="mode-option"><input type="radio" value="everyone"><span><span class="mode-name">Everyone</span><span class="mode-help">Any signed-in user can create public links.</span></span></label><label class="mode-option"><input type="radio" value="employees_admins"><span><span class="mode-name">Employees + admins</span><span class="mode-help">Clients cannot create public links.</span></span></label><label class="mode-option"><input type="radio" value="admins_only"><span><span class="mode-name">Admins only</span><span class="mode-help">Only admins can create public links.</span></span></label></fieldset><section class="allowlist"><h2 class="form-h2">Allowlist</h2><p class="fh-field-help">Users and groups added here can always create public links, regardless of the base policy.</p><div class="fh-field"><span class="fh-field-label">Specific users</span><ul class="picked-list"><li class="picked-row"><span class="row-name">Ada</span><span class="fh-mono row-hint">ada@test.local · employee</span><button type="button" class="fh-btn-text danger">Remove</button></li></ul><input aria-label="Search by name or email…" type="search" class="fh-field-input" autocomplete="off" placeholder="Search by name or email…"></div><div class="fh-field"><span class="fh-field-label">Group memberships</span><ul class="group-checks"><li><label class="group-check"><input type="checkbox" checked=""><span class="group-name">design</span></label></li><li><label class="group-check"><input type="checkbox"><span class="group-name">inbox</span><span class="fh-pill">company inbox</span></label></li></ul></div></section><fieldset id="external-recipients" class="mode-fieldset"><legend class="fh-field-label">Recipients without an account</legend><p class="fh-field-help">Let senders type an email address that has no account. That person gets the share's public link by email; no account is created. Only senders who may create public links (above) can use it, and the password of a protected link is never in the email.</p><label class="mode-option"><input type="checkbox" data-testid="external-enabled"><span><span class="mode-name">Allow sending to addresses without an account</span><span class="mode-help">Off: the recipient list only finds existing accounts and groups.</span></span></label><label class="mode-option"><input type="checkbox" disabled="" data-testid="external-offer-invite"><span><span class="mode-name">Ask the sender whether to also invite them</span><span class="mode-help">The new-share form offers to invite each such address as a client account. Unticked by default; the link goes out either way.</span></span></label></fieldset><div class="actions"><button type="submit" class="fh-btn">Save</button></div></form>"`;

exports[`share approval policy page > renders the same form markup 1`] = `"<form class="policy-form"><label class="toggle-row"><input type="checkbox"><span><span class="mode-name">Require approval for new shares</span><span class="mode-help">When off, shares go live immediately as before.</span></span></label><fieldset class="mode-fieldset"><legend class="fh-field-label">Who can approve</legend><label class="mode-option"><input type="radio" value="admins_only"><span><span class="mode-name">Admins only</span><span class="mode-help">Only administrators can approve or reject shares.</span></span></label><label class="mode-option"><input type="radio" value="employees_admins"><span><span class="mode-name">Employees and admins</span><span class="mode-help">Any employee or admin can approve or reject shares.</span></span></label></fieldset><section class="allowlist"><h2 class="form-h2">Additional approvers</h2><p class="fh-field-help">Optionally add specific users or groups as approvers on top of the base set above.</p><div class="fh-field"><span class="fh-field-label">Users</span><ul class="picked-list"><li class="picked-row"><span class="row-name">Ada</span><span class="fh-mono row-hint">ada@test.local · employee</span><button type="button" class="fh-btn-text danger">Remove</button></li></ul><input aria-label="Search users by name or email…" type="search" class="fh-field-input" autocomplete="off" placeholder="Search users by name or email…"></div><div class="fh-field"><span class="fh-field-label">Groups</span><ul class="group-checks"><li><label class="group-check"><input type="checkbox" checked=""><span class="group-name">design</span></label></li><li><label class="group-check"><input type="checkbox"><span class="group-name">inbox</span></label></li></ul></div></section><label class="fh-field"><span class="fh-field-label">Which shares need approval</span><select class="fh-field-input"><option value="outbound">Outbound only (staff → recipients)</option><option value="all">All shares (including client uploads)</option><option value="outbound_to_clients">Outbound to clients only</option></select></label><label class="toggle-row"><input type="checkbox"><span><span class="mode-name">Approvers' own shares skip approval</span><span class="mode-help">When on, a share created by someone who can approve goes live immediately (no self-approval, no deadlock).</span></span></label><label class="toggle-row"><input type="checkbox"><span><span class="mode-name">Approvers can review file contents</span><span class="mode-help">When on, approvers can preview or download a pending share's files to inspect them before deciding.</span></span></label><div class="actions"><button type="submit" class="fh-btn">Save</button></div></form>"`;
