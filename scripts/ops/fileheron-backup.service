# fileHeron nightly backup (oneshot, driven by the .timer).
# Install: see the main README "Backups & Restore". Adapt User=/paths to your
# deployment (these match the reference install at /opt/fileHeron).
#   sudo cp scripts/ops/fileheron-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now fileheron-backup.timer
#
# Runs backup.sh: dumps the DB, tars files+quarantine, snapshots Redis, writes a
# sha256 manifest, optionally pushes to restic, and prunes to the last 7 local
# backups. A non-zero exit marks the unit `failed` (systemctl --failed +
# journald) AND triggers fileheron-alert-failure@.service, which mails the
# app's configured alert recipients. Install that unit too, or the OnFailure=
# line below refers to a unit that does not exist.
[Unit]
Description=fileHeron nightly backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=getafix
Group=getafix
WorkingDirectory=/opt/fileHeron
ExecStart=/opt/fileHeron/scripts/backup.sh
# DB dump + tarring files/quarantine can take a while on a large store.
TimeoutStartSec=1800
Nice=10
# Alerting on failure. fileheron-alert-failure@.service mails the app's
# configured alert recipients; install it alongside this unit.
OnFailure=fileheron-alert-failure@%n.service
