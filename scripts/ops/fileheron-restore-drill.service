# fileHeron end-to-end backup restore drill (oneshot, driven by the .timer).
# Install: see scripts/ops/README or the main README "Backups & Restore".
#   sudo cp scripts/ops/fileheron-restore-drill.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now fileheron-restore-drill.timer
#
# Runs restore_drill_e2e.sh, which: verifies the latest backup's artifacts, then
# restores it into an ISOLATED throwaway compose project and runs
# restore_validate.py - never touching the live stack. A non-zero exit marks the
# unit `failed` (visible in `systemctl --failed` + journald) AND triggers
# fileheron-alert-failure@.service, which mails the app's configured alert
# recipients. Install that unit too, or the OnFailure= line below refers to a
# unit that does not exist.
[Unit]
Description=fileHeron end-to-end backup restore drill
After=docker.service
Requires=docker.service
# MUST live in [Unit] - systemd parses OnFailure= here only. In [Service] it is
# silently ignored ("Unknown key 'OnFailure' in section [Service]"), which is
# how this shipped inert in v2.12.0: the unit looked wired and `systemctl show
# -p OnFailure` returned empty. fileheron-alert-failure@.service mails the app's
# configured alert recipients; install it alongside this unit.
OnFailure=fileheron-alert-failure@%n.service

[Service]
Type=oneshot
User=getafix
Group=getafix
WorkingDirectory=/opt/fileHeron
ExecStart=/opt/fileHeron/scripts/restore_drill_e2e.sh
# DB import + forward-migration + validate can take a few minutes.
TimeoutStartSec=1800
Nice=10
