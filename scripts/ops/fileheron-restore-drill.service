# fileHeron end-to-end backup restore drill (oneshot, driven by the .timer).
# Install: see scripts/ops/README or the main README "Backups & Restore".
#   sudo cp scripts/ops/fileheron-restore-drill.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now fileheron-restore-drill.timer
#
# Runs restore_drill_e2e.sh, which: verifies the latest backup's artifacts, then
# restores it into an ISOLATED throwaway compose project and runs
# restore_validate.py - never touching the live stack. A non-zero exit marks the
# unit `failed` (visible in `systemctl --failed` + journald). Wire OnFailure= to
# your alerting if you want a push/email.
[Unit]
Description=fileHeron end-to-end backup restore drill
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=getafix
Group=getafix
WorkingDirectory=/opt/fileHeron
ExecStart=/opt/fileHeron/scripts/restore_drill_e2e.sh
# DB import + forward-migration + validate can take a few minutes.
TimeoutStartSec=1800
Nice=10
# Uncomment + provide a unit to get alerted on a failed drill:
# OnFailure=status-email@%n.service
